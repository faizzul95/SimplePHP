{
    "description": "MythPHP using native PHP",
    "name": "faizzul95/mythphp",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\Http\\Controllers\\": "app/http/controllers/",
            "App\\Http\\Middleware\\": "app/http/middleware/",
            "App\\Http\\Requests\\": "app/http/requests/",
            "App\\Http\\": "app/http/",
            "App\\Console\\Commands\\": "app/console/commands/",
            "App\\Console\\Concerns\\": "app/console/concerns/",
            "App\\Console\\": "app/console/",
            "App\\Providers\\": "app/providers/",
            "App\\Support\\": "app/support/",
            "App\\DTO\\": "app/DTO/",
            "App\\Jobs\\": "app/jobs/",
            "App\\Models\\": "app/models/",
            "App\\Repositories\\": "app/repositories/",
            "App\\Services\\": "app/services/",
            "App\\": "app/",
            "Core\\": "systems/Core/",
            "Components\\": "systems/Components/",
            "Middleware\\": "systems/Middleware/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Fixtures\\": "tests/Fixtures/",
            "Tests\\Feature\\": "tests/Feature/"
        }
    },
    "config": {
        "process-timeout": 4000,
        "optimize-autoloader": true,
        "classmap-authoritative": false,
        "sort-packages": true
    },
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^6.10",
        "google/apiclient": "^2.18"
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "//stan": "Cold-cache analysis of ~100k LOC exceeds the 512M default and crashes mid-run, which reports dozens of phantom 'return statement is missing' errors. Always pass the limit.",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "check": [
            "@test",
            "@stan"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^1.12",
        "roave/security-advisories": "dev-latest"
    }
}
