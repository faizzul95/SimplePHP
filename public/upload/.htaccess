# Randomised upload filenames are only unguessable while the index is unpublished.
Options -Indexes

# Never execute anything in the upload tree.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
